# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session Signing (32+ random characters)
AUTH_SECRET=replace-with-a-random-32-character-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Inngest
INNGEST_EVENT_KEY=local-dev-key
INNGEST_SIGNING_KEY=local-signing-key

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
